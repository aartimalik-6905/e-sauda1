# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
# .env.local is already gitignored, so your keys never get committed.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cashfree credentials are SERVER-SIDE Supabase Edge Function secrets.
# Do NOT add CASHFREE_APP_ID or CASHFREE_SECRET_KEY as VITE_ variables here.
# Configure them with: supabase secrets set CASHFREE_APP_ID=... CASHFREE_SECRET_KEY=...
